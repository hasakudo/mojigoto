{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://web.mojigoto.com/schemas/progress-summary-v1.json",
  "title": "もじごと SNS進捗概要",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "generatedAt", "timeZone", "period", "work", "stats", "daily"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "mojigoto-progress-summary" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "timeZone": { "type": "string", "minLength": 1 },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "startDate", "endDate", "days"],
      "properties": {
        "date": { "$ref": "#/$defs/date" },
        "startDate": { "$ref": "#/$defs/date" },
        "endDate": { "$ref": "#/$defs/date" },
        "days": { "const": 7 }
      }
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": ["titleVisible", "title"],
      "properties": {
        "titleVisible": { "type": "boolean" },
        "title": { "type": "string" }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["totalCharacters", "todayCharacters", "last7DaysCharacters", "notesUpdatedToday", "conceptMemosUpdatedToday"],
      "properties": {
        "totalCharacters": { "type": "integer", "minimum": 0 },
        "todayCharacters": { "type": "integer" },
        "last7DaysCharacters": { "type": "integer" },
        "notesUpdatedToday": { "type": "integer", "minimum": 0 },
        "conceptMemosUpdatedToday": { "type": "integer", "minimum": 0 }
        ,"monthCharacters": { "type": "integer" }
        ,"notesUpdatedThisMonth": { "type": "integer", "minimum": 0 }
        ,"conceptMemosUpdatedThisMonth": { "type": "integer", "minimum": 0 }
        ,"yearCharacters": { "type": "integer" }
        ,"notesUpdatedThisYear": { "type": "integer", "minimum": 0 }
        ,"conceptMemosUpdatedThisYear": { "type": "integer", "minimum": 0 }
      }
    },
    "daily": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "characters"],
        "properties": {
          "date": { "$ref": "#/$defs/date" },
          "characters": { "type": "integer" }
        }
      }
    },
    "monthly": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["month", "characters"],
        "properties": {
          "month": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
          "characters": { "type": "integer" }
        }
      }
    },
    "workBreakdown": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "characters"],
        "properties": {
          "title": { "type": "string" },
          "characters": { "type": "integer" }
        }
      }
    },
    "annual": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["month", "characters"],
        "properties": {
          "month": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
          "characters": { "type": "integer" }
        }
      }
    },
    "annualWorkBreakdown": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "characters"],
        "properties": {
          "title": { "type": "string" },
          "characters": { "type": "integer" }
        }
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
