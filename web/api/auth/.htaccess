Options -Indexes
DirectoryIndex index.php

<FilesMatch "^(bootstrap|admin-session|token-verification|review-login-notification|config(?:\.example)?)\.php$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
</IfModule>
