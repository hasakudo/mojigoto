    "keybindings": [
      {
        "key": "ctrl+alt+v",
        "command": "mojigoto.openPreviewBeside"
      },
      {
        "key": "ctrl+alt+s",
        "command": "mojigoto.serverStop"
      },
      {
        "key": "ctrl+alt+r",
        "command": "mojigoto.serverRestart"
      },
      {
        "key": "alt+r",
        "command": "mojigoto.insertRubyFromSelection",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "key": "alt+b",
        "command": "mojigoto.insertSideDotsFromSelection",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "key": "shift+alt+c",
        "command": "mojigoto.stripRubyFromSelection",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "key": "alt+m",
        "command": "mojigoto.addWritingMemo",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "mojigoto.typeWithAutoIndent",
        "key": "enter",
        "when": "editorTextFocus && !editorReadonly",
        "args": {
          "text": "\n"
        }
      },
      {
        "command": "mojigoto.typeWithAutoIndent",
        "key": "shift+enter",
        "when": "editorTextFocus && !editorReadonly",
        "args": {
          "text": "\n",
          "shift": true
        }
      },
      {
        "command": "mojigoto.insertEllipsis",
        "key": "shift+alt+.",
        "when": "editorTextFocus"
      },
      {
        "command": "mojigoto.insertDashPair",
        "key": "shift+alt+-",
        "when": "editorTextFocus"
      },
      {
        "command": "mojigoto.wrapWithDoublePrime",
        "key": "shift+alt+2",
        "when": "editorTextFocus"
      },
      {
        "command": "mojigoto.noteEditor.closeFromShortcut",
        "key": "ctrl+w",
        "mac": "cmd+w",
        "when": "activeWebviewPanelId == 'mojigoto.noteEditor'"
      }
