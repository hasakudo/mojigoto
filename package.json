{
  "name": "mojigoto",
  "displayName": "もじごと",
  "description": "VS Codeで小説や長文を書くための執筆補助拡張。原稿管理、縦書きプレビュー、プロット・資料ノート、構想メモ、執筆メモ、文字数集計、書き出しに対応。",
  "version": "1.0.0",
  "publisher": "hasakudo",
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./extension.js",
  "icon": "images/icon.png",
  "license": "MIT",
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hasakudo/mojigoto.git"
  },
  "activationEvents": [
    "onLanguage:markdown",
    "onLanguage:plaintext",
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "もじごと（執筆補助）",
      "properties": {
        "mojigoto.mode": {
          "type": "string",
          "enum": [
            "single",
            "multi"
          ],
          "markdownEnumDescriptions": [
            "1つの作品だけを管理する",
            "複数の作品を切り替えて管理する"
          ],
          "default": "single",
          "description": "初回セットアップで選択した運用モード",
          "category": "もじごと:セットアップ",
          "order": 0
        },
        "mojigoto.defaultFileExtension": {
          "type": "string",
          "default": ".txt",
          "enum": [
            ".txt",
            ".md"
          ],
          "description": "もじごとで新規作成する原稿ファイルの既定拡張子",
          "category": "もじごと:セットアップ",
          "order": 1
        },
        "mojigoto.manuscriptRoot": {
          "type": "string",
          "default": "",
          "description": "プレビュー同期や進捗管理などを行う基準フォルダ",
          "category": "もじごと:セットアップ",
          "order": 2
        },
        "mojigoto.manuscriptCandidates": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "manuscript",
            "原稿"
          ],
          "description": "作品フォルダ内で「原稿フォルダ」として認識する名前候補（作品切替の検出に使用）",
          "category": "もじごと:セットアップ",
          "order": 3
        },
        "mojigoto.workRoot": {
          "type": "string",
          "default": "",
          "description": "作品フォルダが入っているルートフォルダのパス（作品切替に使用）",
          "category": "もじごと:作品",
          "order": 10
        },
        "mojigoto.workPickLimit": {
          "type": "number",
          "default": 10,
          "description": "作品切替ダイアログに表示する作品の最大件数",
          "category": "もじごと:作品",
          "order": 11
        },
        "mojigoto.workExclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".vscode",
            "CSS",
            "node_modules",
            "publish",
            "tools",
            "_WORK",
            "manuscript",
            "docs",
            "Doc",
            "Doc(s)",
            "temp",
            "tmp",
            "dist",
            ".git"
          ],
          "description": "指定したフォルダ名は作品ツリーおよび作品切替の一覧から除外されます。通常は変更不要です。",
          "category": "もじごと:作品",
          "order": 12
        },
        "mojigoto.totalGoal": {
          "type": "number",
          "default": 0,
          "description": "作品全体の目標文字数（進捗％の計算に使用）\n例：100000",
          "category": "もじごと:執筆",
          "order": 20
        },
        "mojigoto.countMode": {
          "type": "string",
          "default": "default",
          "enum": [
            "default",
            "withFullWidthSpaces",
            "withNewlines",
            "withSpacesAndNewlines",
            "allInclusive",
            "allExceptNewlines"
          ],
          "markdownEnumDescriptions": [
            "ルビ/見出し記号・空白・改行を除いて数えます。",
            "ルビ/見出し記号・改行を除き、全角空白を含めて数えます。",
            "ルビ/見出し記号・空白を除き、改行を含めて数えます。",
            "ルビ/見出し記号を除き、空白と改行を含めて数えます。",
            "ルビ/見出し記号・空白・改行を含め、すべて数えます。",
            "ルビ/見出し記号・空白を含めて数えます。改行のみ除きます。"
          ],
          "markdownDescription": "文字数カウント方式を切り替えます。",
          "category": "もじごと:執筆",
          "order": 21
        },
        "mojigoto.rubyPipeStyle": {
          "type": "string",
          "default": "half",
          "enum": [
            "half",
            "full"
          ],
          "markdownEnumDescriptions": [
            "半角 `|` ",
            "全角 `｜`"
          ],
          "markdownDescription": "ルビ挿入コマンドで使う記号を選びます。`half` は `|`、`full` は `｜` です。",
          "category": "もじごと:執筆",
          "order": 22
        },
        "mojigoto.autoIndentEnabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "改行時に次の行へ全角スペースを自動挿入します。Shift を押しながらの改行では挿入しません。",
          "category": "もじごと:執筆",
          "order": 23
        },
        "mojigoto.autoCloseAssistEnabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "`「` と `（` の閉じ記号を自動補完する機能の ON / OFF です。",
          "category": "もじごと:執筆",
          "order": 24
        },
        "mojigoto.writingMemoDecorationsEnabled": {
          "type": "boolean",
          "default": true,
          "description": "エディタ上で執筆メモの下線表示を有効にします。",
          "category": "もじごと:執筆",
          "order": 25
        },
        "mojigoto.highlightsEnabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "ハイライト機能全体の ON / OFF です。不要な場合はここで無効化できます。",
          "category": "もじごと:ハイライト",
          "order": 30
        },
        "mojigoto.highlightDecorationsEnabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "ハイライト装飾の ON / OFF です。不要な場合はここで無効化できます。",
          "category": "もじごと:ハイライト",
          "order": 31
        },
        "mojigoto.highlightGroups": {
          "type": "array",
          "default": [],
          "markdownDescription": "ハイライト分析で使う検出グループです。\n\n通常は設定画面から直接編集せず、Dashboard のハイライト分析にある **ハイライト設定** ボタン、または `もじごと:ハイライト設定を開く` から編集してください。\n\n既存グループへの語句追加、新規グループ作成、装飾スタイル変更に使用します。",
          "category": "もじごと:ハイライト",
          "order": 32,
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "内部識別名"
              },
              "label": {
                "type": "string",
                "description": "表示名"
              },
              "enabled": {
                "type": "boolean",
                "description": "有効/無効"
              },
              "words": {
                "type": "array",
                "description": "単語一致の対象一覧",
                "items": {
                  "type": "string"
                }
              },
              "regex": {
                "type": "string",
                "description": "行単位で評価する正規表現"
              },
              "style": {
                "type": "object",
                "description": "装飾スタイル",
                "properties": {
                  "backgroundColor": {
                    "type": "string"
                  },
                  "color": {
                    "type": "string"
                  },
                  "border": {
                    "type": "string"
                  },
                  "fontWeight": {
                    "type": "string"
                  },
                  "textDecoration": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "tags": [
            "advanced"
          ]
        },
        "mojigoto.dashboardShowTextMemos": {
          "type": "boolean",
          "default": false,
          "description": "ダッシュボードで通常メモを表示する",
          "category": "もじごと:ダッシュボード",
          "order": 40
        },
        "mojigoto.dashboardShowListMemos": {
          "type": "boolean",
          "default": false,
          "description": "ダッシュボードでリストメモを表示する",
          "category": "もじごと:ダッシュボード",
          "order": 41
        },
        "mojigoto.dashboardShowTodoMemos": {
          "type": "boolean",
          "default": true,
          "description": "ダッシュボードでTODOメモを表示する",
          "category": "もじごと:ダッシュボード",
          "order": 42
        },
        "mojigoto.exportRoot": {
          "type": "string",
          "default": "",
          "description": "書き出し先の親フォルダ。未設定の場合、初回の書き出し時に選択します。作品ごとに用途別フォルダを自動作成します。",
          "category": "もじごと:書き出し",
          "order": 50
        },
        "mojigoto.mergedManuscriptJoinMode": {
          "type": "string",
          "default": "headingAware",
          "enum": [
            "headingAware",
            "single",
            "double"
          ],
          "markdownEnumDescriptions": [
            "見出し付きなら改行1つ、見出しなしなら改行2つ",
            "常に改行1つ",
            "常に改行2つ"
          ],
          "markdownDescription": "原稿結合書き出し時のファイル間改行ルール",
          "category": "もじごと:書き出し",
          "order": 51
        },
        "mojigoto.verticalPunctuationLayout": {
          "type": "string",
          "default": "hanging",
          "enum": [
            "hanging",
            "pushout"
          ],
          "markdownEnumDescriptions": [
            "句読点は行末にぶら下げる。閉じ括弧や ！？ が行頭に来ないよう追い出します。",
            "句読点と閉じ括弧を行末に追い込み寄りに配置します。"
          ],
          "markdownDescription": "縦書きHTML書き出し時の句読点・閉じ括弧の配置方法を切り替えます。",
          "category": "もじごと:書き出し",
          "order": 52
        },
        "mojigoto.useTypographyAdjustments": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "縦書きプレビューと原稿書き出しで、ぶら下げ・追い込みなどの自動体裁調整を使用します。OFFでは本文の並びを優先し、自動調整を行いません。",
          "category": "もじごと:書き出し",
          "order": 53
        },
        "mojigoto.exportIncludeFolderName": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "作品設定のHTML書き出しにフォルダ名を含めます。",
          "category": "もじごと:書き出し",
          "order": 54
        },
        "mojigoto.exportIncludeGenre": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "作品設定のHTML書き出しにジャンルを含めます。",
          "category": "もじごと:書き出し",
          "order": 55
        },
        "mojigoto.exportIncludeTargetChars": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "作品設定のHTML書き出しに目標文字数を含めます。",
          "category": "もじごと:書き出し",
          "order": 56
        },
        "mojigoto.exportIncludeDeadline": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "作品設定のHTML書き出しに締切日を含めます。",
          "category": "もじごと:書き出し",
          "order": 57
        },
        "mojigoto.exportIncludeMemo": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "作品設定のHTML書き出しにメモを含めます。",
          "category": "もじごと:書き出し",
          "order": 58
        },
        "mojigoto.exportIncludeUpdatedAt": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "作品設定のHTML書き出しに更新日時を含めます。単一書き出しのみ",
          "category": "もじごと:書き出し",
          "order": 59
        },
        "mojigoto.sheetsEnabled": {
          "type": "boolean",
          "default": false,
          "description": "執筆記録をGoogle Sheetsへ記録する機能を有効にする（Webhook送信/シート作成/送信ボタン等）",
          "category": "もじごと:統計送信",
          "order": 60
        },
        "mojigoto.projectName": {
          "type": "string",
          "default": "",
          "description": "統計送信用の作品名（Sheets側の「作品」列に入る名前）空なら現在の作品名を自動使用（設定には保存しません）",
          "category": "もじごと:統計送信",
          "order": 61
        },
        "mojigoto.webhookUrl": {
          "type": "string",
          "default": "",
          "description": "Apps Script WebアプリのURL",
          "category": "もじごと:統計送信",
          "order": 62
        },
        "mojigoto.webhookSecret": {
          "type": "string",
          "default": "",
          "description": "Apps Script用のSECRET",
          "category": "もじごと:統計送信",
          "order": 63
        },
        "mojigoto.webhookProgressMode": {
          "type": "string",
          "enum": [
            "off",
            "onSave"
          ],
          "markdownEnumDescriptions": [
            "送らない",
            "保存時に送る"
          ],
          "default": "onSave",
          "description": "Progress（進捗）を送るタイミング",
          "category": "もじごと:統計送信",
          "order": 64
        },
        "mojigoto.webhookEventsMode": {
          "type": "string",
          "enum": [
            "off",
            "onSave",
            "onCommand"
          ],
          "markdownEnumDescriptions": [
            "送らない",
            "保存時に1件ずつ",
            "ボタン実行で未送信分だけ送る"
          ],
          "default": "off",
          "description": "日時ログ（Daily_Log）を送るタイミング。ボタンでの送信は執筆記録から行う。",
          "category": "もじごと:統計送信",
          "order": 66
        },
        "mojigoto.eventLogIntervalMinutes": {
          "type": "number",
          "enum": [
            0,
            1,
            5,
            15,
            30,
            60
          ],
          "default": 5,
          "description": "日時ログを保存する最小間隔（分）。0=毎回保存",
          "category": "もじごと:統計",
          "order": 70
        },
        "mojigoto.webhookEventsRemindMode": {
          "type": "string",
          "enum": [
            "off",
            "weekly",
            "monthly"
          ],
          "markdownEnumDescriptions": [
            "通知しない",
            "7日超",
            "30日超"
          ],
          "default": "off",
          "description": "日時ログ（Daily_Log）の送信忘れ通知。最後の送信からの日数（未送信がある場合に通知）",
          "category": "もじごと:統計",
          "order": 71
        },
        "mojigoto.eventsMaxCount": {
          "type": "number",
          "default": 4000,
          "description": "日時ログの最大保存件数。超えた分は古い順に削除します。",
          "category": "もじごと:統計",
          "order": 72
        },
        "mojigoto.eventsRetentionDays": {
          "type": "number",
          "default": 90,
          "description": "日時ログの保持日数。0=無制限。件数制限より前でも、保持日数を過ぎたデータは削除します。",
          "category": "もじごと:統計",
          "order": 73
        },
        "mojigoto.dailyRetentionDays": {
          "type": "number",
          "default": 365,
          "description": "進捗データ・更新ファイル履歴の保持日数。0=無制限。",
          "category": "もじごと:統計",
          "order": 74
        },
        "mojigoto.statusBarCountsEnabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "ステータスバーの文字数カウンター（ファイル / 章 / 総）を表示します。",
          "category": "もじごと:表示",
          "order": 90
        },
        "mojigoto.hideChapterNumber": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "作品ツリーで章フォルダ名の先頭番号を非表示にします。実際のフォルダ名は変更しません。",
          "category": "もじごと:表示",
          "order": 91
        },
        "mojigoto.debug": {
          "type": "boolean",
          "default": false,
          "description": "デバッグログを有効にします（通常はオフでOK）",
          "category": "もじごと:その他",
          "order": 999
        }
      }
    },
    "commands": [
      {
        "command": "mojigoto.ping",
        "title": "プレビューサーバー接続確認",
        "category": "もじごと"
      },
      {
        "command": "mojigoto.toggle",
        "title": "プレビュー自動同期 ON/OFF",
        "category": "もじごと"
      },
      {
        "command": "mojigoto.openPreviewBeside",
        "title": "縦書きプレビューを開く",
        "category": "もじごと"
      },
      {
        "command": "mojigoto.serverStop",
        "title": "プレビューサーバーを停止",
        "category": "もじごと"
      },
      {
        "command": "mojigoto.serverRestart",
        "title": "プレビューサーバーを再起動",
        "category": "もじごと"
      },
      {
        "command": "mojigoto.switchWorkAndRestart",
        "title": "作品を切り替え",
        "category": "もじごと"
      },
      {
        "command": "mojigoto.copyPreviewUrl",
        "title": "プレビューURLをコピー",
        "category": "もじごと"
      },
      {
        "command": "mojigoto.doctor",
        "title": "自己診断（Doctor）",
        "category": "もじごと"
      },
      {
        "command": "mojigoto.selectCountMode",
        "title": "文字数カウント方式を変更",
        "category": "もじごと"
      },
      {
        "command": "mojigoto.openStats",
        "title": "ダッシュボードを開く",
        "category": "もじごと"
      },
      {
        "command": "mojigoto.setExportRoot",
        "title": "書き出し先の親フォルダを設定",
        "category": "もじごと"
      },
      {
        "command": "mojigoto.exportStatsCsv",
        "title": "執筆記録CSVを出力",
        "category": "もじごと"
      },
      {
        "command": "mojigoto.refreshHighlights",
        "title": "ハイライトを更新",
        "category": "もじごと"
      },
      {
        "command": "mojigoto.toggleHighlights",
        "title": "ハイライトをON/OFF",
        "category": "もじごと"
      },
      {
        "command": "mojigoto.openHighlightSettings",
        "title": "ハイライト設定を開く",
        "category": "もじごと"
      },
      {
        "command": "mojigoto.typeWithAutoIndent",
        "title": "自動字下げ機能",
        "category": "もじごと"
      },
      {
        "command": "mojigoto.treeOpenSettings",
        "title": "作品設定を開く",
        "category": "もじごと"
      },
      {
        "command": "mojigoto.createEmptyConceptMemos",
        "title": "構想メモを開く",
        "category": "もじごと"
      },
      {
        "command": "mojigoto.addWritingMemo",
        "title": "== 執筆メモを追加 ==",
        "category": "もじごと"
      },
      {
        "command": "mojigoto.treeCreatePlot",
        "title": "プロットを新規作成",
        "category": "もじごと",
        "icon": "$(add)"
      },
      {
        "command": "mojigoto.treeCreateReference",
        "title": "資料を新規作成",
        "category": "もじごと",
        "icon": "$(add)"
      },
      {
        "command": "mojigoto.treeCreateWork",
        "title": "作品を新規作成",
        "category": "もじごと"
      },
      {
        "command": "mojigoto.createManuscriptFile",
        "title": "原稿ファイルを新規作成",
        "category": "もじごと",
        "icon": "$(new-file)"
      },
      {
        "command": "mojigoto.createManuscriptFolder",
        "title": "章フォルダを新規作成",
        "category": "もじごと",
        "icon": "$(new-folder)"
      },
      {
        "command": "mojigoto.treeRenameEntry",
        "title": "名前を変更",
        "category": "もじごと",
        "icon": "$(pencil)"
      },
      {
        "command": "mojigoto.moveManuscriptFile",
        "title": "移動...",
        "category": "もじごと",
        "icon": "$(move)"
      },
      {
        "command": "mojigoto.refreshWorkTree",
        "title": "作品ツリーを更新",
        "category": "もじごと",
        "icon": "$(refresh)"
      },
      {
        "command": "mojigoto.treeOpenReorder",
        "title": "原稿/章の並び順エディタを開く",
        "category": "もじごと",
        "icon": "$(list-ordered)"
      },
      {
        "command": "mojigoto.openGuide",
        "title": "もじごとガイドを開く",
        "category": "もじごと",
        "icon": "$(question)"
      },
      {
        "command": "mojigoto.openInitialSetup",
        "title": "初回セットアップを開く",
        "category": "もじごと",
        "icon": "$(tools)"
      },
      {
        "command": "mojigoto.openVsCodeSettings",
        "title": "VS Code 設定を開く",
        "category": "もじごと",
        "icon": "$(settings-gear)"
      },
      {
        "command": "mojigoto.filterWorksByStatus",
        "title": "作品一覧を状態で絞り込み",
        "category": "もじごと",
        "icon": "$(filter)"
      },
      {
