PUBLISHING.md

# Detailed development history is kept separately from public release notes.
docs/development-changelog.md

# Local investigation and generated release artifacts
.tmp-web-investigation/**
release/**

# Authentication runtime data; keep only its directory protection rule
web/api/auth/data/**
!web/api/auth/data/.htaccess

# Development documentation and build tools are kept in Git, not in the extension
docs/**
scripts/**
server/web-dev.mjs

# Include only the PHP configuration example, never local backup variants
web/api/auth/config*.php
!web/api/auth/config.example.php
